# Bolão do Max — template de configuração
#
# Copie para .env e preencha. O .env NUNCA vai para o git.
# Instruções de cadastro em cada fonte: docs/_atual/cfg.fornecedores.md
#
# Toda variável é validada no boot (packages/config, zod). Faltando ou
# malformada, a aplicação não sobe — em vez de cair em fallback silencioso.

# ─────────────────────────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=America/Sao_Paulo
LOG_LEVEL=info

WEB_PORT=3000
WORKER_PORT=3100

# Temporada ativa. O worker só coleta dados dela.
TEMPORADA_ATUAL=2026
SERIE=A

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
# Local  : compose.dev.yml sobe um Postgres descartável
# Produção: instância compartilhada `banco` (pgvector/pg17) na rede rede-banco.
#           Database e role próprios do bolão — nunca o superusuário `postgres`.
DATABASE_URL=postgres://bolao:senha_local@localhost:5432/bolao

# Pool. 2 vCPU no servidor: manter modesto.
DATABASE_POOL_MAX=8
DATABASE_POOL_IDLE_TIMEOUT_S=30

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
# Local  : compose.dev.yml sobe um Redis descartável
# Produção: instância compartilhada `cache` (redis:8) na rede rede-cache,
#           com outros inquilinos. O prefixo é obrigatório para não colidir.
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=bolao:v1:

# Cache derivado, nunca fonte da verdade. Perder o Redis não perde dado.
REDIS_TTL_RESULTADOS_S=900

# ─────────────────────────────────────────────────────────────
# Fonte: GE — api.globoesporte.globo.com
# ─────────────────────────────────────────────────────────────
# Primária de alta frequência. Sem cadastro, sem chave, sem cota.
# Sem SLA: pode mudar o payload ou bloquear por IP sem aviso.
# As duas rotas precisam ser mapeadas no DevTools — ver cfg.fornecedores.md §3.
PROVIDER_GE_ENABLED=true
PROVIDER_GE_URL_CLASSIFICACAO=
PROVIDER_GE_URL_AGENDA=
PROVIDER_GE_USER_AGENT=BolaoDoMax/1.0 (+https://bolao.maxmat1.com.br)
PROVIDER_GE_TIMEOUT_MS=8000
PROVIDER_GE_RETRY=2

# Cadência auto-imposta. Ser educado com fonte gratuita é requisito.
PROVIDER_GE_INTERVALO_JOGO_S=180
PROVIDER_GE_INTERVALO_DIA_JOGO_S=1800
PROVIDER_GE_INTERVALO_OCIOSO_S=43200

# ─────────────────────────────────────────────────────────────
# Fonte: API-Football (API-Sports)
# ─────────────────────────────────────────────────────────────
# Conferência e fallback. Free tier: 100 req/dia, 10 req/min, sem cartão.
# Cadastro: https://dashboard.api-football.com/register
PROVIDER_APIFOOTBALL_ENABLED=true
PROVIDER_APIFOOTBALL_KEY=
PROVIDER_APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
PROVIDER_APIFOOTBALL_LEAGUE_ID=
PROVIDER_APIFOOTBALL_TIMEOUT_MS=10000

# Tetos auto-impostos, abaixo dos limites reais (100/dia, 10/min).
# A margem impede que um bug de laço queime a cota do dia.
PROVIDER_APIFOOTBALL_QUOTA_DAY=60
PROVIDER_APIFOOTBALL_QUOTA_MINUTE=8

# ─────────────────────────────────────────────────────────────
# Fonte: football-data.org
# ─────────────────────────────────────────────────────────────
# Desempate e calendário. Free tier: 10 req/min, sem teto diário publicado.
# Cadastro: https://www.football-data.org/client/register
PROVIDER_FOOTBALLDATA_ENABLED=true
PROVIDER_FOOTBALLDATA_KEY=
PROVIDER_FOOTBALLDATA_BASE_URL=https://api.football-data.org/v4
PROVIDER_FOOTBALLDATA_COMPETITION=BSA
PROVIDER_FOOTBALLDATA_TIMEOUT_MS=10000
PROVIDER_FOOTBALLDATA_QUOTA_MINUTE=8

# ─────────────────────────────────────────────────────────────
# Reconciliação
# ─────────────────────────────────────────────────────────────
# Ordem de confiança. Divergência entre as duas primeiras aciona a terceira
# e adota a maioria. Toda discordância vai para a tabela `divergencia`.
RECONCILIACAO_ORDEM=ge,apifootball,footballdata
RECONCILIACAO_MINIMO_FONTES=2
RECONCILIACAO_ALARMA_DIVERGENCIA=true

# ─────────────────────────────────────────────────────────────
# Worker
# ─────────────────────────────────────────────────────────────
WORKER_ENABLED=true

# Sincronismo diário do calendário — captura remarcação da CBF. 1 requisição.
WORKER_CRON_CALENDARIO=0 3 * * *

# Janela em que uma partida é considerada "em andamento",
# contada a partir do horário previsto de início.
WORKER_JANELA_JOGO_ANTES_MIN=15
WORKER_JANELA_JOGO_DEPOIS_MIN=150

# Snapshot só quando a tabela muda de verdade (hash). Desligar apenas
# para depuração: gravar a cada ciclo infla o banco sem ganho.
WORKER_SNAPSHOT_SOMENTE_MUDANCA=true
