extends layout

block content
  script(src='/javascripts/bolao.js')
  link(rel='stylesheet', href= brw.mobile ? '/stylesheets/style.mob.css' : '/stylesheets/style.css'  )
  h1 
    img(src='/images/pp.jpg') 
    = ' BOLÃO DO MAX - BRASILEIRÃO ' + bolao.ano
  h2 
    = `Resultados em tempo real (atualizado em ${bolao.atualizado_em})`
  br
  
  h3 BOLÃO CLÁSSICO 

  br
  table(class='table-striped')
    tbody
      tr 
        each val in ['Pos','Nome','Pts','SG', 'Prêmio']
          th(rowspan='2')= val
        th(colspan=4,class='centro')= 'Clubes'
      tr
        each val in ['GP1','GP2','GP3','GP4']
          th(class='centro')= val
    each c in bolao.Competidores
      tr(onclick=`demonstrativo(${JSON.stringify(c)});`)
        td(class='direita')= c.Posicao
        td= c.Nome
        td(class='direita spacamento-lateral')= c.Pontos
        td(class='direita spacamento-lateral ' + (c.Saldo_Gols < 0?'vermelho':''))= c.Saldo_Gols
        td(class='direita spacamento-lateral ')= c.Premio
        each t in c.Clubes
          td(class='centro ' + (t.Coracao ?'coracao':''))=  t.Clube 
  div
    br
    br
    br

  h3 BOLÃO POR POSIÇÃO 
  
  table(class='table-striped')
    tbody
      tr 
        each val in ['Pos','Nome','Pts','Prêmio']
          th(rowspan='4')= val
        th(colspan=1,class='centro')= 'Clubes G4'
        th(colspan=1,class='centro')= 'Clubes Z4'
      tr
        each val in ['1ª/2ª/3º/4º','17ª/18ª/19º/20º']
          th(class='centro')= val
    each c in bolao.BolaoNovo
      tr(onclick=`demonstrativo(${JSON.stringify(c)});`)
        td(class='centro')= c.PosicaoG4Z4
        td= c.Nome
        td(class='esquerda spacamento-lateral')= c.PontosG4Z4
        td(class='meio spacamento-lateral')= c.PremioG4Z4
        td(class='')
          ol(type='1',start='1')
            each t in c.PalpitesPosicao
                if t.posicao <=4 
                  li=t.Clube + ' ' + ((t.acertoPosicao) ? '✅' : '') + ( (!t.acertoPosicao) && (t.acertoG4 || t.acertoZ4) ? '👍' : '')
        td(class='')
          ol(type='1',start='17')
            each t in c.PalpitesPosicao
                if t.posicao >=17 
                  li=t.Clube + ' ' + ((t.acertoPosicao) ? '✅' : '') + ( (!t.acertoPosicao) && (t.acertoG4 || t.acertoZ4) ? '👍' : '')
  div
    = 'Legenda: ✅ = Acertou a posição (4 pontos) | 👍 = Acertou o G4 ou Z4 (1 ponto)'
    br
    br
  div
    br
    b= 'Regras Bolões do MAX ' + bolao.ano
    br
    = '1) A aposta esse ano custa R$155,00 e deve ser paga antes de acabar o campeonato e será dividido em 2 bolões:'
    br
    br
    b
      i= 'Regras Bolão Clássico ' + bolao.ano + ':'
      br
    = '2) Você concorre com a soma dos pontos dos quatro clubes do seu conjunto.'
    br
    = '3) O saldo de gols dos conjuntos é o único critério de desempate... Caso permaneça empatado, o prêmio será dividido.'
    br
    = '4) 1º lugar (R$ 2.000,00)... 2º lugar (R$ 650,00)... 3º lugar (R$ 350,00).... 30º lugar (R$ 120,00)'
    br
    br
    b 
      i= 'Regras Bolão de Posição ' + bolao.ano + ':'
      br
    = '5) O apostador escolhe os 4 primeiros colocados (G4) e os 4 últimos colocados (Z4) e suas respectivas posições da tabela ao final da última rodada (G4 = 1ª/2ª/3ª/4ª e Z4 = 17ª/18ª/19ª/20ª).'
    br
    = '6) Você concorre com a soma dos pontos conforme a regra:'
    br
    = '6a) Acertou o clube no G4 ou no Z4, ganha 1 ponto (marcados com 👍).'
    br
    = '6b) Acertou a posição exata do clube no G4 ou no Z4, ganha além do ponto do G4/Z4 mais 3 pontos, totalizando 4 pontos (marcados com ✅).'
    br
    = '7) 1º lugar ganha R$ 1.000,00 ... havendo empate, o prêmio será dividido entre os que empatarem na primeira posição.'
    br
    br
    b 
      i= 'Bolão da Mega Sena da Virada ' + bolao.ano + '/' + (bolao.ano+1) + ':'
      br
    = '8) Com os R$530 restantes, será feita nossa aposta de 9 dezenas na Mega sena da virada, e o que sobrar ainda pode ficar como custos do Bolão ou podemos resolver outra coisa qualquer...'
    br
