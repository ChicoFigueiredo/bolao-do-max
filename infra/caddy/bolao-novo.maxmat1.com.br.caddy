# Bolão do Max novo — domínio de convivência (127.0.0.1:5002, o mesmo container).
#
# Instalado por infra/bin/deploy.ts em /etc/caddy/sites/. Esta é a fonte: mudou aqui,
# o próximo `bun run deploy` copia, valida e recarrega o Caddy. O certificado é do
# próprio Caddy (HTTP-01), sem passo à parte. `import log` vem do Caddyfile base,
# que mora no repositório de infraestrutura da VPS.
bolao-novo.maxmat1.com.br {
	import log

	reverse_proxy 127.0.0.1:5002 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 30s
		}
	}
}
